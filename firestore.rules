rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile: users can only read and write their own document
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User checks subcollection: users can only read, write, and delete their own checks
      match /checks/{checkId} {
        allow read, write, delete: if isOwner(userId);
      }

      // User fix plans: users can only read, write, and delete their own fix plans
      match /fixPlans/{planId} {
        allow read, write, delete: if isOwner(userId);
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
