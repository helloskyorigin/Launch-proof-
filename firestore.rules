rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Identity & Authentication Helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 3. Entity-Specific Schema & Data Integrity Validation Helpers
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'onboardingCompleted', 'plan'])
        && data.uid == request.auth.uid
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 100
        && data.onboardingCompleted is bool
        && (data.plan == 'free' || data.plan == 'pro' || data.plan == 'pro_plus')
        && (!data.keys().hasAny(['name']) || (data.name is string && data.name.size() <= 100))
        && (!data.keys().hasAny(['photoURL']) || (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048)))
        && (!data.keys().hasAny(['productType']) || (data.productType == null || (data.productType is string && data.productType.size() <= 100)))
        && (!data.keys().hasAny(['currentStage']) || (data.currentStage == null || (data.currentStage is string && data.currentStage.size() <= 100)))
        && (!data.keys().hasAny(['auditFocus']) || (data.auditFocus == null || (data.auditFocus is string && data.auditFocus.size() <= 100)))
        && (!data.keys().hasAny(['createdAt']) || data.createdAt is timestamp)
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp);
    }

    function isValidCheckRecord(data) {
      return data.keys().hasAll(['id', 'userId', 'url', 'status'])
        && data.userId == request.auth.uid
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.url is string && data.url.size() <= 2048
        && data.status is string && data.status.size() <= 100
        && (!data.keys().hasAny(['normalizedUrl']) || (data.normalizedUrl is string && data.normalizedUrl.size() <= 2048))
        && (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 5000))
        && (!data.keys().hasAny(['productType']) || (data.productType is string && data.productType.size() <= 100))
        && (!data.keys().hasAny(['score']) || (data.score == null || data.score is number))
        && (!data.keys().hasAny(['verdict']) || (data.verdict == null || (data.verdict is string && data.verdict.size() <= 100)))
        && (!data.keys().hasAny(['error']) || (data.error == null || (data.error is string && data.error.size() <= 10000)))
        && (!data.keys().hasAny(['createdAt']) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // 4. Secure Database Paths and Operations
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      
      // Allow profile creation
      allow create: if isOwner(userId) && isValidId(userId) 
        && isValidUserProfile(request.resource.data);
      
      // Allow updates to owned profiles with immutability guards
      allow update: if isOwner(userId) && isValidId(userId)
        && isValidUserProfile(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && (!resource.data.keys().hasAny(['createdAt']) || request.resource.data.createdAt == resource.data.createdAt);

      match /checks/{checkId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(checkId);
        
        // List check results securely
        allow list: if isOwner(userId) && isValidId(userId);
        
        // Allow check creation
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(checkId)
          && isValidCheckRecord(request.resource.data);
        
        // Allow check updates with immutability safeguards
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(checkId)
          && isValidCheckRecord(request.resource.data)
          && request.resource.data.id == resource.data.id
          && request.resource.data.userId == resource.data.userId
          && (!resource.data.keys().hasAny(['createdAt']) || request.resource.data.createdAt == resource.data.createdAt);
          
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(checkId);
      }
    }
  }
}
