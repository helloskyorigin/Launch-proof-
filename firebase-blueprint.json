{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document stored under users/{uid}",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique Firebase Authentication UID"
        },
        "name": {
          "type": "string",
          "description": "User display name"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "photoURL": {
          "type": "string",
          "description": "User profile photo URL"
        },
        "productType": {
          "type": "string",
          "description": "Type of product the user is building"
        },
        "currentStage": {
          "type": "string",
          "description": "Current lifecycle stage of the product"
        },
        "auditFocus": {
          "type": "string",
          "description": "User focus area for audits"
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Flag indicating if user completed onboarding"
        },
        "plan": {
          "type": "string",
          "enum": ["free", "pro", "pro_plus"],
          "description": "Subscription plan tier"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["uid", "email", "onboardingCompleted", "plan"]
    },
    "CheckRecord": {
      "title": "CheckRecord",
      "description": "Audit check record stored under users/{uid}/checks/{checkId}",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique check identifier"
        },
        "checkId": {
          "type": "string",
          "description": "Check identifier"
        },
        "userId": {
          "type": "string",
          "description": "Owner Firebase UID"
        },
        "url": {
          "type": "string",
          "description": "Target product URL inspected"
        },
        "finalUrl": {
          "type": "string",
          "description": "Final resolved URL after redirects"
        },
        "description": {
          "type": "string",
          "description": "Product context or description"
        },
        "productType": {
          "type": "string",
          "description": "Category of product"
        },
        "status": {
          "type": "string",
          "description": "Current status of the check run"
        },
        "score": {
          "type": "number",
          "description": "Overall LaunchScore (0-100)"
        },
        "verdict": {
          "type": "string",
          "description": "Summary verdict of the audit"
        },
        "deterministicChecks": {
          "type": "object",
          "description": "Map of deterministic check results"
        },
        "findings": {
          "type": "array",
          "description": "List of findings identified"
        },
        "categoryScores": {
          "type": "object",
          "description": "Scores grouped by category"
        },
        "fixPlan": {
          "type": "array",
          "description": "Prioritized action items to resolve findings"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when check was created"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when check was completed"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last status update"
        }
      },
      "required": ["id", "userId", "url", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "entity": "UserProfile",
      "description": "User profile document"
    },
    "/users/{userId}/checks/{checkId}": {
      "entity": "CheckRecord",
      "description": "Audit check documents for a specific user"
    }
  }
}
